APP_NAME="Dasbor Eksekutif Gorontalo"
APP_ENV=production
APP_KEY=            # isi dengan kunci acak (lihat README, langkah 3)
APP_DEBUG=false
APP_URL=https://dasbor.elkhair.my.id
APP_LOCALE=id

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=elkhair1_dasbor
DB_USERNAME=elkhair1_dasbor
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Panel admin (/admin). Isi hash bcrypt, bukan kata sandi asli.
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=
# Token minimal 24 karakter acak untuk /pemeliharaan/{token}/{tugas}
MAINTENANCE_TOKEN=

BSPS_BASE_URL=https://pkp.go.id/cek-penerima-bsps
SP2KP_BASE_URL=https://api-sp2kp.kemendag.go.id
